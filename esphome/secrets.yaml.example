# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "MyNetwork"
wifi_password: "changeme"
# Fallback hotspot password, used if the plug cannot join Wi-Fi
ap_password: "changeme"
# Native API encryption keys, one per plug; they also encrypt OTA updates.
# Home Assistant asks for them when adding each plug. Generate each with:
#   head -c 32 /dev/urandom | base64
plug_3d_printer_api_key: "changeme"
plug_desktop_api_key: "changeme"
plug_server_api_key: "changeme"
plug_tv_api_key: "changeme"
