{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just)",
      "Bash(just --list)",
      "Bash(just check)",
      "Bash(just build:*)",
      "Bash(just build-all)",
      "Bash(just diff:*)",
      "Bash(just fmt)",
      "Bash(just logs:*)",
      "Bash(just status:*)",
      "Bash(nix eval:*)",
      "Bash(nix flake show:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix flake check:*)",
      "Bash(nix search:*)",
      "Bash(nix log:*)",
      "Bash(nix why-depends:*)",
      "Bash(nix build .#nixosConfigurations.*:*)",
      "Bash(nixos-rebuild build:*)",
      "Bash(nixos-rebuild dry-build:*)",
      "Bash(nvd:*)",
      "Bash(nixfmt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git add:*)",
      "Bash(git submodule status:*)"
    ],
    "ask": [
      "Bash(just update:*)",
      "Bash(just deploy-wsl)",
      "Bash(just deploy-server)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nix copy:*)",
      "Bash(nh:*)",
      "Bash(nixos-rebuild switch:*)",
      "Bash(nixos-rebuild boot:*)",
      "Bash(nixos-rebuild test:*)",
      "Bash(nix flake update:*)",
      "Bash(nix flake lock:*)",
      "Bash(nix-collect-garbage:*)",
      "Bash(nix store gc:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git submodule update:*)",
      "Bash(sops:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(run0:*)",
      "Read(~/.ssh/**)",
      "Bash(cat ~/.ssh/**)",
      "Read(/etc/secrets/**)",
      "Read(/run/secrets/**)",
      "Read(/run/secrets.d/**)",
      "Read(~/.config/sops/**)",
      "Read(**/keys.txt)",
      "Read(**/*.dec.*)",
      "Read(**/esphome/secrets.yaml)",
      "Read(**/esphome/*/secrets.yaml)",
      "Bash(cat /etc/secrets/**)",
      "Bash(sops -d:*)",
      "Bash(sops --decrypt:*)",
      "Bash(sops decrypt:*)",
      "Bash(nix run nixpkgs#sops:*)",
      "Bash(nix shell nixpkgs#sops:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/nixfmt.sh"
          }
        ]
      }
    ]
  }
}
