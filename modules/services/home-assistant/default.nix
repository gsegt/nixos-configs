{
  pkgs,
  lib,
  config,
  ...
}:

let
  service = "home-assistant";
  # Keep in sync with external_url in home-assistant/configuration.yaml
  subdomain = "home";
  uri = "${subdomain}.${config.modules.services.reverse-proxy.domain}";
  home_assistant_ref_dir = "/etc/nixos/modules/services/${service}/home-assistant";
  home_assistant_volume_dir = "${cfg.volumeDir}/home-assistant";
  home_assistant_config_dir = "${home_assistant_volume_dir}/config";
  home_assistant_port = 8123;
  # Pinned so home-assistant/configuration.yaml can trust the reverse proxy,
  # which reaches the container from this network's gateway. Keep in sync with
  # trusted_proxies.
  subnet = "10.89.100.0/24";
  cfg = config.modules.services.${service};
in
{
  options.modules.services.${service} = {
    enable = lib.mkEnableOption "Whether to enable custom ${service} settings.";

    volumeDir = lib.mkOption {
      type = lib.types.path;
    };
  };

  config = lib.mkIf cfg.enable {
    # Home Assistant runs as root inside the container
    systemd.tmpfiles.rules = [
      "d ${cfg.volumeDir} 0755 ${config.modules.base.userName} ${config.modules.base.groupName} - -"
      "d ${home_assistant_volume_dir} 0755 root root - -"
      "d ${home_assistant_config_dir} 0755 root root - -"
      # Included by configuration.yaml and written by the UI editors; only
      # created when missing, never overwritten.
      "f ${home_assistant_config_dir}/automations.yaml 0644 root root - []"
      "f ${home_assistant_config_dir}/scripts.yaml 0644 root root - -"
      "f ${home_assistant_config_dir}/scenes.yaml 0644 root root - -"
    ];

    services.${config.modules.services.reverse-proxy.service} = {
      virtualHosts."${uri}".extraConfig = ''
        reverse_proxy localhost:${toString home_assistant_port}
      '';
    };

    modules.services.dyndns-ovh.subdomains = [ subdomain ];

    # Containers
    virtualisation.oci-containers.containers."home-assistant-home-assistant" = {
      image = "ghcr.io/home-assistant/home-assistant:stable";
      environment = {
        "TZ" = config.time.timeZone;
      };
      volumes = [
        "${home_assistant_config_dir}:/config:rw"
        "${home_assistant_ref_dir}/configuration.yaml:/config/configuration.yaml:ro"
      ];
      ports = [
        "${toString home_assistant_port}:8123/tcp"
      ];
      labels = {
        "io.containers.autoupdate" = "registry";
      };
      log-driver = "journald";
      extraOptions = [
        "--network-alias=home-assistant"
        "--network=home-assistant"
      ];
    };
    systemd.services."podman-home-assistant-home-assistant" = {
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      # Reload config on switch (it is bind-mounted, not copied)
      restartTriggers = [ ./home-assistant/configuration.yaml ];
      after = [
        "podman-network-home-assistant.service"
      ];
      requires = [
        "podman-network-home-assistant.service"
      ];
      partOf = [
        "podman-compose-home-assistant-root.target"
      ];
      wantedBy = [
        "podman-compose-home-assistant-root.target"
      ];
    };

    # Networks
    systemd.services."podman-network-home-assistant" = {
      path = [ pkgs.podman ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStop = "podman network rm -f home-assistant";
      };
      script = ''
        podman network inspect home-assistant || podman network create home-assistant --subnet=${subnet}
      '';
      partOf = [ "podman-compose-home-assistant-root.target" ];
      wantedBy = [ "podman-compose-home-assistant-root.target" ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-home-assistant-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = [ "multi-user.target" ];
    };
  };
}
