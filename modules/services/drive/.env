LOG_DRIVER=journald

OC_DOCKER_IMAGE=docker.io/opencloudeu/opencloud-rolling
OC_DOCKER_TAG=latest
OC_CONTAINER_UID_GID="1000:1000"
OC_DOMAIN=drive.gsegt.eu
OC_CONFIG_DIR=/media/external/data-vault/services/drive/opencloud/config
OC_DATA_DIR=/media/external/data-vault/services/drive/opencloud/data

EURO_OFFICE_DOMAIN=office.gsegt.eu

SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_SENDER="OpenCloud Notifications <drive@gsegt.eu>"
SMTP_USERNAME=mail@gsegt.eu
# SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_TRANSPORT_ENCRYPTION=starttls

START_ADDITIONAL_SERVICES=notifications

DEFAULT_LANGUAGE=en

# nix run nixpkgs#compose2nix -- -auto_format -write_nix_setup=false -enable_option -project drive -inputs "modules/services/drive/compose/docker-compose.yml,modules/services/drive/compose/weboffice/euro-office.yml,modules/services/drive/compose/external-proxy/opencloud.yml,modules/services/drive/compose/external-proxy/euro-office.yml" -env_files modules/services/drive/.env -output modules/services/drive/default-debug.nix
