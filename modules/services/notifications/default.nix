{
  pkgs,
  lib,
  config,
  ...
}:

let
  service = "notifications";
  subdomain = service;
  uri = "${subdomain}.${config.modules.services.reverse-proxy.domain}";
  ntfy_volume_dir = "${cfg.volumeDir}/ntfy";
  ntfy_uid = 0;
  ntfy_gid = 0;
  ntfy_port = 2586;
  cfg = config.modules.services.${service};
in
{
  options.modules.services.${service} = {
    enable = lib.mkEnableOption "Whether to enable custom ${service} settings.";

    volumeDir = lib.mkOption {
      type = lib.types.path;
    };
  };

  config = lib.mkIf cfg.enable {
    # Users, ACL entries and tokens, see .env
    sops.secrets."notifications/ntfy/env" = {
      restartUnits = [ "podman-notifications-ntfy.service" ];
    };

    systemd.tmpfiles.rules = [
      "d ${cfg.volumeDir} 0755 ${config.modules.base.userName} ${config.modules.base.groupName} - -"
      "d ${ntfy_volume_dir} 0755 ${toString ntfy_uid} ${toString ntfy_gid} - -"
    ];

    # Caddy proxies WebSockets (used by the Android app) without extra config
    services.${config.modules.services.reverse-proxy.service} = {
      virtualHosts."${uri}".extraConfig = ''
        reverse_proxy localhost:${toString ntfy_port}
      '';
    };

    modules.services.dyndns-ovh.subdomains = [ subdomain ];

    # Containers
    virtualisation.oci-containers.containers."notifications-ntfy" = {
      image = "docker.io/binwiederhier/ntfy:latest";
      environment = {
        "NTFY_AUTH_DEFAULT_ACCESS" = "deny-all";
        "NTFY_AUTH_FILE" = "/var/lib/ntfy/auth.db";
        "NTFY_BASE_URL" = "https://${uri}";
        "NTFY_BEHIND_PROXY" = "true";
        "NTFY_CACHE_FILE" = "/var/lib/ntfy/cache.db";
        "NTFY_ENABLE_LOGIN" = "true";
        "NTFY_LISTEN_HTTP" = ":80";
        # Web app shows only the login page until signed in
        "NTFY_REQUIRE_LOGIN" = "true";
      };
      environmentFiles = [
        config.sops.secrets."notifications/ntfy/env".path
      ];
      volumes = [
        "${ntfy_volume_dir}:/var/lib/ntfy:rw"
      ];
      ports = [
        "127.0.0.1:${toString ntfy_port}:80/tcp"
      ];
      cmd = [ "serve" ];
      labels = {
        "compose2nix.settings.sops.secrets" = "notifications/ntfy/env";
        "io.containers.autoupdate" = "registry";
      };
      log-driver = "journald";
      extraOptions = [
        "--network-alias=ntfy"
        "--network=notifications"
      ];
    };
    systemd.services."podman-notifications-ntfy" = {
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      after = [
        "podman-network-notifications.service"
      ];
      requires = [
        "podman-network-notifications.service"
      ];
      partOf = [
        "podman-compose-notifications-root.target"
      ];
      wantedBy = [
        "podman-compose-notifications-root.target"
      ];
    };

    # Networks
    systemd.services."podman-network-notifications" = {
      path = [ pkgs.podman ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStop = "podman network rm -f notifications";
      };
      script = ''
        podman network inspect notifications || podman network create notifications
      '';
      partOf = [ "podman-compose-notifications-root.target" ];
      wantedBy = [ "podman-compose-notifications-root.target" ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-notifications-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = [ "multi-user.target" ];
    };
  };
}
