# ntfy
# Comma-separated, no quotes (podman env files keep them literally).
# Hash passwords with `ntfy user hash`; generate tokens with `ntfy token generate`.

# <user>:<bcrypt-hash>:<admin|user>
NTFY_AUTH_USERS=
# <user>:<topic>:<read-write|read-only|write-only|deny>
NTFY_AUTH_ACCESS=
# <user>:<tk_token>:<label>
NTFY_AUTH_TOKENS=
