{
  pkgs,
  lib,
  config,
  ...
}:

let
  service = "dav";
  subdomain = service;
  uri = "${subdomain}.${config.modules.services.reverse-proxy.domain}";
  radicale_volume_dir = "${cfg.volumeDir}/radicale";
  radicale_data_dir = "${radicale_volume_dir}/data";
  radicale_ref_dir = "/etc/nixos/modules/services/${service}";
  radicale_uid = 1000;
  radicale_gid = 1000;
  radicale_port = 5232;
  cfg = config.modules.services.${service};
in
{
  options.modules.services.${service} = {
    enable = lib.mkEnableOption "Whether to enable custom ${service} settings.";

    volumeDir = lib.mkOption {
      type = lib.types.path;
    };
  };

  config = lib.mkIf cfg.enable {
    sops.secrets."dav/radicale/htpasswd" = {
      uid = radicale_uid;
      gid = radicale_gid;
    };

    systemd.tmpfiles.rules = [
      "d ${cfg.volumeDir} 0755 ${config.modules.base.userName} ${config.modules.base.groupName} - -"
      "d ${radicale_volume_dir} 0755 ${toString radicale_uid} ${toString radicale_gid} - -"
      "d ${radicale_data_dir} 0755 ${toString radicale_uid} ${toString radicale_gid} - -"
    ];

    services.${config.modules.services.reverse-proxy.service} = {
      virtualHosts."${uri}".extraConfig = ''
          reverse_proxy localhost:${toString radicale_port}{
          header_up Host {host}
          header_up X-Forwarded-Port {port}
          header_up X-Remote-User {http.auth.user.id}
        }
      '';
    };

    modules.services.dyndns-ovh.subdomains = [ subdomain ];

    # Containers
    virtualisation.oci-containers.containers."dav-radicale" = {
      image = "docker.io/kozea/radicale:stable";
      volumes = [
        "${radicale_ref_dir}/config:/etc/radicale/config:ro"
        "${radicale_ref_dir}/create_birthday_calendar.py:/usr/local/bin/create_birthday_calendar.py:ro"
        "${radicale_data_dir}:/var/lib/radicale:rw"
        "${config.sops.secrets."dav/radicale/htpasswd".path}:/run/secrets/htpasswd:ro"
      ];
      ports = [
        "${toString radicale_port}:5232/tcp"
      ];
      labels = {
        "io.containers.autoupdate" = "registry";
      };
      log-driver = "journald";
      extraOptions = [
        "--network-alias=radicale"
        "--network=dav"
      ];
    };
    systemd.services."podman-dav-radicale" = {
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      after = [
        "podman-network-dav.service"
      ];
      requires = [
        "podman-network-dav.service"
      ];
      partOf = [
        "podman-compose-dav-root.target"
      ];
      wantedBy = [
        "podman-compose-dav-root.target"
      ];
    };

    # Networks
    systemd.services."podman-network-dav" = {
      path = [ pkgs.podman ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStop = "podman network rm -f dav";
      };
      script = ''
        podman network inspect dav || podman network create dav
      '';
      partOf = [ "podman-compose-dav-root.target" ];
      wantedBy = [ "podman-compose-dav-root.target" ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-dav-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = [ "multi-user.target" ];
    };
  };
}
