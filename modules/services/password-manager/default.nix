{
  pkgs,
  lib,
  config,
  ...
}:

let
  service = "password-manager";
  subdomain = service;
  uri = "${subdomain}.${config.modules.services.reverse-proxy.domain}";
  vaultwarden_volume_dir = "${cfg.volumeDir}/vaultwarden";
  vaultwarden_data_dir = "${vaultwarden_volume_dir}/data";
  vaultwarden_uid = 0;
  vaultwarden_gid = 0;
  vaultwarden_port = 8000;
  cfg = config.modules.services.${service};
in
{
  options.modules.services.${service} = {
    enable = lib.mkEnableOption "Whether to enable custom ${service} settings.";

    volumeDir = lib.mkOption {
      type = lib.types.path;
    };
  };

  config = lib.mkIf cfg.enable {
    sops.secrets."password-manager/vaultwarden/env" = { };

    systemd.tmpfiles.rules = [
      "d ${cfg.volumeDir} 0755 ${config.modules.base.userName} ${config.modules.base.groupName} - -"
      "d ${vaultwarden_volume_dir} 0755 ${toString vaultwarden_uid} ${toString vaultwarden_gid} - -"
      "d ${vaultwarden_data_dir} 0755 ${toString vaultwarden_uid} ${toString vaultwarden_gid} - -"
    ];

    services.${config.modules.services.reverse-proxy.service} = {
      virtualHosts."${uri}".extraConfig = ''
          reverse_proxy localhost:${toString vaultwarden_port}{
          header_up X-Real-IP {remote_host}
        }
      '';
    };

    modules.services.dyndns-ovh.subdomains = [ subdomain ];

    # Containers
    virtualisation.oci-containers.containers."password-manager-vaultwarden" = {
      image = "docker.io/vaultwarden/server:latest";
      environment = {
        "DOMAIN" = "https://${uri}";
        "SIGNUPS_ALLOWED" = "false";
        "SMTP_FROM" = "${subdomain}@${config.modules.services.reverse-proxy.domain}";
        "SMTP_HOST" = config.programs.msmtp.accounts.default.host;
        "SMTP_PORT" = toString config.programs.msmtp.accounts.default.port;
        "SMTP_SECURITY" = "starttls";
        "SMTP_USERNAME" = config.programs.msmtp.accounts.default.user;
      };
      environmentFiles = [
        config.sops.secrets."password-manager/vaultwarden/env".path
      ];
      volumes = [
        "${vaultwarden_data_dir}:/data:rw"
      ];
      ports = [
        "${toString vaultwarden_port}:80/tcp"
      ];
      labels = {
        "compose2nix.settings.sops.secrets" = "password-manager/vaultwarden/env";
        "io.containers.autoupdate" = "registry";
      };
      log-driver = "journald";
      extraOptions = [
        "--network-alias=vaultwarden"
        "--network=password-manager"
      ];
    };
    systemd.services."podman-password-manager-vaultwarden" = {
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      after = [
        "podman-network-password-manager.service"
      ];
      requires = [
        "podman-network-password-manager.service"
      ];
      partOf = [
        "podman-compose-password-manager-root.target"
      ];
      wantedBy = [
        "podman-compose-password-manager-root.target"
      ];
    };

    # Networks
    systemd.services."podman-network-password-manager" = {
      path = [ pkgs.podman ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStop = "podman network rm -f password-manager";
      };
      script = ''
        podman network inspect password-manager || podman network create password-manager
      '';
      partOf = [ "podman-compose-password-manager-root.target" ];
      wantedBy = [ "podman-compose-password-manager-root.target" ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-password-manager-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = [ "multi-user.target" ];
    };
  };
}
