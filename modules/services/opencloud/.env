LOG_DRIVER=journald

OC_DOCKER_IMAGE=docker.io/opencloudeu/opencloud-rolling
OC_DOCKER_TAG=latest
OC_CONTAINER_UID_GID="1000:1000"
OC_DOMAIN=opencloud.gsegt.eu
OC_CONFIG_DIR=/media/external/data-vault/services/opencloud/config
OC_DATA_DIR=/media/external/data-vault/services/opencloud/data

COLLABORA_DOMAIN=collabora.gsegt.eu
COLLABORA_SSL_ENABLE=false
COLLABORA_SSL_VERIFICATION=false
WOPISERVER_DOMAIN=wopi.gsegt.eu

# nix run nixpkgs#compose2nix -- -auto_format -write_nix_setup=false -enable_option -project opencloud -inputs "modules/services/opencloud/compose/docker-compose.yml,modules/services/opencloud/compose/weboffice/collabora.yml,modules/services/opencloud/compose/external-proxy/opencloud.yml,modules/services/opencloud/compose/external-proxy/collabora.yml" -env_files modules/services/opencloud/.env -output modules/services/opencloud/default-debug.nix
