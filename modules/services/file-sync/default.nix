{
  pkgs,
  lib,
  config,
  ...
}:

let
  service = "file-sync";
  syncthing_volume_dir = "${cfg.volumeDir}/syncthing";
  syncthing_config_dir = "${syncthing_volume_dir}/config";
  syncthing_data_dir = "${syncthing_volume_dir}/data";
  # Same as the user, so synced files are readable over SMB
  syncthing_uid = config.modules.base.uid;
  syncthing_gid = config.modules.base.gid;
  syncthing_gui_port = 8384;
  syncthing_sync_port = 22000;
  cfg = config.modules.services.${service};
in
{
  options.modules.services.${service} = {
    enable = lib.mkEnableOption "Whether to enable custom ${service} settings.";

    volumeDir = lib.mkOption {
      type = lib.types.path;
    };
  };

  config = lib.mkIf cfg.enable {
    # Each container unit creates its own folders below (preStart): tmpfiles
    # refuses to create paths owned by another user under volumeDir, which
    # the user owns ("unsafe path transition").
    systemd.tmpfiles.rules = [
      "d ${cfg.volumeDir} 0755 ${config.modules.base.userName} ${config.modules.base.groupName} - -"
    ];

    # LAN only: nothing is forwarded on the router, so remote devices go
    # through relays. No reverse proxy for the GUI.
    networking.firewall = {
      allowedTCPPorts = [
        syncthing_gui_port
        syncthing_sync_port
      ];
      allowedUDPPorts = [ syncthing_sync_port ];
    };

    # Not behind Caddy, so the generated https probes don't cover it
    modules.services.monitoring.blackboxTargets = [
      "http://host.containers.internal:${toString syncthing_gui_port}/rest/noauth/health"
    ];

    # Containers
    virtualisation.oci-containers.containers."file-sync-syncthing" = {
      image = "docker.io/syncthing/syncthing:latest";
      environment = {
        "PGID" = toString syncthing_gid;
        "PUID" = toString syncthing_uid;
        "STNODEFAULTFOLDER" = "1";
        "TZ" = config.modules.base.timeZone;
      };
      volumes = [
        "${syncthing_config_dir}:/var/syncthing/config:rw"
        "${syncthing_data_dir}:/var/syncthing/data:rw"
      ];
      ports = [
        "${toString syncthing_gui_port}:8384/tcp"
        "${toString syncthing_sync_port}:22000/tcp"
        "${toString syncthing_sync_port}:22000/udp"
      ];
      labels = {
        "io.containers.autoupdate" = "registry";
      };
      log-driver = "journald";
      extraOptions = [
        "--network-alias=syncthing"
        "--network=file-sync"
      ];
    };
    systemd.services."podman-file-sync-syncthing" = {
      preStart = ''
        for d in ${syncthing_volume_dir} ${syncthing_config_dir} ${syncthing_data_dir}; do
          [ -d "$d" ] || install -d -m 0755 -o ${toString syncthing_uid} -g ${toString syncthing_gid} "$d"
        done
      '';
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      after = [
        "podman-network-file-sync.service"
      ];
      requires = [
        "podman-network-file-sync.service"
      ];
      partOf = [
        "podman-compose-file-sync-root.target"
      ];
      wantedBy = [
        "podman-compose-file-sync-root.target"
      ];
    };

    # Networks
    systemd.services."podman-network-file-sync" = {
      path = [ pkgs.podman ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStop = "podman network rm -f file-sync";
      };
      script = ''
        podman network inspect file-sync || podman network create file-sync
      '';
      partOf = [ "podman-compose-file-sync-root.target" ];
      wantedBy = [ "podman-compose-file-sync-root.target" ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-file-sync-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = [ "multi-user.target" ];
    };
  };
}
