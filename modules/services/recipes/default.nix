{
  pkgs,
  lib,
  config,
  ...
}:

let
  service = "recipes";
  subdomain = service;
  uri = "${subdomain}.${config.modules.services.reverse-proxy.domain}";
  mealie_volume_dir = "${cfg.volumeDir}/mealie";
  mealie_data_dir = "${mealie_volume_dir}/data";
  mealie_uid = 911;
  mealie_gid = 911;
  mealie_port = 9000;
  cfg = config.modules.services.${service};
in
{
  options.modules.services.${service} = {
    enable = lib.mkEnableOption "Whether to enable custom ${service} settings.";

    volumeDir = lib.mkOption {
      type = lib.types.path;
    };
  };

  config = lib.mkIf cfg.enable {
    systemd.tmpfiles.rules = [
      "d ${cfg.volumeDir} 0755 ${config.modules.base.userName} ${config.modules.base.groupName} - -"
      "d ${mealie_volume_dir} 0755 ${toString mealie_uid} ${toString mealie_gid} - -"
      "d ${mealie_data_dir} 0755 ${toString mealie_uid} ${toString mealie_gid} - -"
    ];

    services.${config.modules.services.reverse-proxy.service} = {
      virtualHosts."${uri}".extraConfig = ''
        reverse_proxy localhost:${toString mealie_port}
      '';
    };

    modules.services.dyndns-ovh.subdomains = [ subdomain ];

    # Containers
    virtualisation.oci-containers.containers."mealie" = {
      image = "ghcr.io/mealie-recipes/mealie:latest";
      environment = {
        "BASE_URL" = "https://${uri}";
        "PGID" = toString mealie_gid;
        "PUID" = toString mealie_uid;
        "TZ" = config.time.timeZone;
      };
      volumes = [
        "${mealie_data_dir}:/app/data:rw"
      ];
      ports = [
        "${toString mealie_port}:9000/tcp"
      ];
      labels = {
        "io.containers.autoupdate" = "registry";
      };
      log-driver = "journald";
      extraOptions = [
        "--network-alias=mealie"
        "--network=recipes"
      ];
    };
    systemd.services."podman-mealie" = {
      serviceConfig = {
        Restart = lib.mkOverride 90 "always";
      };
      after = [
        "podman-network-recipes.service"
      ];
      requires = [
        "podman-network-recipes.service"
      ];
      partOf = [
        "podman-compose-recipes-root.target"
      ];
      wantedBy = [
        "podman-compose-recipes-root.target"
      ];
    };

    # Networks
    systemd.services."podman-network-recipes" = {
      path = [ pkgs.podman ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        ExecStop = "podman network rm -f recipes";
      };
      script = ''
        podman network inspect recipes || podman network create recipes
      '';
      partOf = [ "podman-compose-recipes-root.target" ];
      wantedBy = [ "podman-compose-recipes-root.target" ];
    };

    # Root service
    # When started, this will automatically create all resources and start
    # the containers. When stopped, this will teardown all resources.
    systemd.targets."podman-compose-recipes-root" = {
      unitConfig = {
        Description = "Root target generated by compose2nix.";
      };
      wantedBy = [ "multi-user.target" ];
    };
  };
}
