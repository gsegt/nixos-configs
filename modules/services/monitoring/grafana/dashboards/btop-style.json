{
  "title": "btop-style System Monitor",
  "uid": "btop-system",
  "description": "Status, CPU temperature and usage, RAM, storage for the system disk and the ZFS pool, pressure, disk and network.",
  "tags": [
    "node-exporter",
    "system"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "instance",
        "label": "Instance",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(node_uname_info, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(node_uname_info, instance)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 0,
        "current": {
          "text": "host.containers.internal:9100",
          "value": "host.containers.internal:9100"
        },
        "options": []
      },
      {
        "type": "constant",
        "name": "pool",
        "label": "ZFS pool",
        "hide": 2,
        "query": "data-vault"
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 12,
      "type": "stat",
      "title": "$pool pool",
      "description": "ZFS pool state. Anything other than online needs attention.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "node_zfs_zpool_state{instance=\"$instance\", zpool=\"$pool\"} == 1",
          "legendFormat": "{{state}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "name",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "MISSING",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "online"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
