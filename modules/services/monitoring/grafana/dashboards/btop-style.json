            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "100 * (node_filesystem_size_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool/.+\"} - node_filesystem_avail_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool/.+\"}) / scalar(sum(node_filesystem_size_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool(/.*)?\"} - node_filesystem_avail_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool(/.*)?\"}) + max(node_filesystem_avail_bytes{instance=\"$instance\", fstype=\"zfs\", device=\"$pool\"}))",
          "legendFormat": "↳ {{device}}",
          "instant": true
