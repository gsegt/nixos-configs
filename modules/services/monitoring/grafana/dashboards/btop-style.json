          "expr": "100 * sum(node_filesystem_size_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool(/.*)?\"} - node_filesystem_avail_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool(/.*)?\"}) / (sum(node_filesystem_size_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool(/.*)?\"} - node_filesystem_avail_bytes{instance=\"$instance\", fstype=\"zfs\", device=~\"$pool(/.*)?\"}) + max(node_filesystem_avail_bytes{instance=\"$instance\", fstype=\"zfs\", device=\"$pool\"}))",
