    {
      "id": 3,
      "type": "timeseries",
      "title": "Energy per hour",
      "description": "Each bar is the energy used during that clock hour, stacked by device. Built from exact 5-minute counter differences; a plug reboot (counter back to 0) is handled.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "1000 * sum_over_time(((esphome_sensor_value{job=\"esphome\", id=\"energy\"} - last_over_time(esphome_sensor_value{job=\"esphome\", id=\"energy\"}[30m] offset 5m)) >= 0 or on(node) (esphome_sensor_value{job=\"esphome\", id=\"energy\"} + 0))[1h:5m])",
          "legendFormat": "{{friendly_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "barAlignment": -1,
            "barWidthFactor": 0.9,
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
